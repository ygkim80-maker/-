# 서버
PORT=3000
BASE_URL=http://localhost:3000

# 자동 재발송 정책
MAX_NOTIFY_ATTEMPTS=3
VOICE_FROM_ATTEMPT=3
RETRY_AFTER_MINUTES=60
RETRY_CRON=*/5 * * * *

# 문자(SMS) 실제 연동 - Aligo (설정 시 자동으로 mock 대신 사용됨)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 문자/ARS 음성 실제 연동 - Twilio (설정 시 자동으로 mock 대신 사용됨)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 기간계(사내 코어 시스템) 연동 - 반송 확정 건을 자동으로 가져와 접수+안내발송까지 수행
# CORE_API_BASE_URL이 비어있으면 데모용 Mock 어댑터가 대신 동작한다.
CORE_API_BASE_URL=
CORE_API_RETURNED_ENDPOINT=/api/returns
CORE_API_SINCE_PARAM=since
# bearer | apikey | basic
CORE_API_AUTH_TYPE=bearer
CORE_API_TOKEN=
CORE_API_KEY_HEADER=x-api-key
CORE_API_USERNAME=
CORE_API_PASSWORD=
# 기간계 응답 필드명이 내부 필드명과 다르면 JSON으로 매핑 지정
# 예: {"trackingNo":"invoiceNo","customerName":"custNm","phone":"custTel","cardType":"prdtNm","branch":"brchNm","address":"addr","returnReason":"rtnRsn","returnedAt":"rtnDt","externalId":"rtnSeq"}
CORE_API_FIELD_MAP=
# 폴링 주기 (기본 10분마다)
CORE_SYNC_CRON=*/10 * * * *
