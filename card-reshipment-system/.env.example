# 서버
PORT=3000
BASE_URL=http://localhost:3000

# 자동 재발송 정책
MAX_NOTIFY_ATTEMPTS=3
VOICE_FROM_ATTEMPT=3
RETRY_AFTER_MINUTES=60
RETRY_CRON=*/5 * * * *

# 문자(SMS) 실제 연동 - Aligo (설정 시 자동으로 mock 대신 사용됨)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 문자/ARS 음성 실제 연동 - Twilio (설정 시 자동으로 mock 대신 사용됨)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
